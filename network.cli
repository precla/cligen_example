# Network Configuration CLI Specification
# This file defines the CLI syntax using CLIgen format

prompt = "network> ";
comment = "#";

# Show available interfaces dynamically
show("Show network configuration") {
    interfaces("Show all interfaces"), show_interfaces();
    interface <ifname:string interface()>("Interface name"), show_interface();
}

# Configure interface IP address
config("Configure network settings") {
    interface <ifname:string interface()>("Interface name") {
        ip <ipaddr:ipv4addr>("IP address"), set_interface_ip();
        no ip, remove_interface_ip();
        ipv6 <ipaddr:ipv6addr>("IPv6 address"), set_interface_ipv6();
        no ipv6, remove_interface_ipv6();
    }
}

# Other commands
help("Show help"), help_cmd();
quit("Quit the CLI"), quit_cmd();
